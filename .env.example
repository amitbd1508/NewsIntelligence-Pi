# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# HERMES_HOST & HERMES_PORT: Configurable LAN binding for Raspberry Pi deployment.
# Bind strictly to LAN IP or localhost; never expose publicly on WAN.
HERMES_HOST="127.0.0.1"
HERMES_PORT="8088"

# OLLAMA_BASE_URL: Apple M1 Mac LAN address running Ollama.
# The system dynamically queries /api/tags to discover the active model.
OLLAMA_BASE_URL="http://192.168.1.50:11434"

# SQLITE_DB_PATH: Dedicated persistent SQLite WAL database path on Raspberry Pi.
SQLITE_DB_PATH="/home/pi/.hermes/data/hermes_news.db"
